# Saytın əsas ünvanı (SEO, sitemap və saytlar arası linklər üçün).
# Boş qalsa: dev-də http://localhost:3000, prod-da https://cesgroup.az.
# Construction və Farmart linkləri bundan çıxarılır (lokalda construction.localhost:3000).
NEXT_PUBLIC_SITE_URL=https://cesgroup.az

# Ayrı tətbiq olan Equipment və Architect üçün ünvan (verilməsə canlı sayta gedir).
# Lokalda onları öz portunda işlədirsinizsə yazın, məs. http://localhost:3001
# NEXT_PUBLIC_URL_EQUIPMENT=
# NEXT_PUBLIC_URL_ARCHITECT=

# SMTP — əlaqə formasından gələn müraciətlər üçün
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@cesgroup.az
SMTP_PASS=
MAIL_FROM="CES Group <no-reply@cesgroup.az>"

# Hər şirkətin müraciət emaili (boş qalarsa CONTACT_FALLBACK_EMAIL istifadə olunur)
CONTACT_EMAIL_EQUIPMENT=sales@ces.com.az
CONTACT_EMAIL_ARCHITECT=
CONTACT_EMAIL_CONSTRUCTION=
CONTACT_EMAIL_FARMART=
CONTACT_FALLBACK_EMAIL=info@cesgroup.az

# Telegram bildirişi
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
